# InSafe Environment Configuration
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/insafe?schema=public

# Auth (pick one: Supabase or Firebase)
# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Auth (alternative)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Provider
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@insafe.app

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_SERVER_KEY=

# Storage (for profile photos, fake call caller photos)
STORAGE_BUCKET=
STORAGE_REGION=

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOCATION_UPDATE_INTERVAL_MINUTES=2
SOS_SMS_RESEND_INTERVAL_MINUTES=10
